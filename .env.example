# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── NVIDIA NIM ────────────────────────────────────────────────────────────────
# Get your FREE key at: https://build.nvidia.com
# Sign up → Generate API Key (prefixed nvapi-)
VITE_NVIDIA_API_KEY=nvapi-your-key-here

# ─── USDA Food Database (Optional) ────────────────────────────────────────────
# DEMO_KEY works with rate limits. Get a free key at: https://fdc.nal.usda.gov/api-key-signup
VITE_USDA_API_KEY=DEMO_KEY
